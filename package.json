    "icons": "node scripts/import-icons.mjs",
    "goldens": "vitest run --config vitest.regen.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@xyflow/react": "^12.11.2",
    "highs": "^1.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
